<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/primary">

    <!-- Top Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="4dp"
        android:paddingEnd="16dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="Back"
            android:tint="@color/white"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Forgot PIN"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold"/>

    </LinearLayout>

    <!-- Content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        android:paddingTop="40dp"
        android:paddingBottom="32dp">

        <!-- Lock icon -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔑"
            android:textSize="52sp"
            android:gravity="center"
            android:layout_marginBottom="24dp"/>

        <!-- Step 1: Security Question (shown first) -->
        <LinearLayout
            android:id="@+id/layoutQuestion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Answer your security question"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginBottom="20dp"/>

            <!-- The question text -->
            <TextView
                android:id="@+id/tvSecurityQuestion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:gravity="center"
                android:alpha="0.85"
                android:layout_marginBottom="16dp"/>

            <!-- Answer input -->
            <EditText
                android:id="@+id/etAnswer"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/input_bg"
                android:hint="Your answer..."
                android:textColorHint="@color/hint_color"
                android:textColor="@color/input_text"
                android:textSize="15sp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:singleLine="true"
                android:inputType="text"
                android:imeOptions="actionDone"/>

            <!-- Error message -->
            <TextView
                android:id="@+id/tvAnswerError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Wrong answer. Try again."
                android:textColor="#FF5252"
                android:textSize="13sp"
                android:gravity="center"
                android:layout_marginTop="8dp"
                android:visibility="gone"/>

            <!-- Confirm button -->
            <Button
                android:id="@+id/btnConfirmAnswer"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="20dp"
                android:text="Confirm Answer"
                android:textSize="15sp"
                android:backgroundTint="@color/btn_bg"
                android:textColor="@color/btn_text"/>

        </LinearLayout>

        <!-- Step 2: Set New PIN (hidden until answer is correct) -->
        <LinearLayout
            android:id="@+id/layoutNewPin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvNewPinLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Set your new PIN"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginBottom="24dp"/>

            <!-- PIN dots -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="32dp">

                <View android:id="@+id/dot1"
                    android:layout_width="16dp" android:layout_height="16dp"
                    android:layout_margin="8dp"
                    android:background="@drawable/pin_dot_empty"/>
                <View android:id="@+id/dot2"
                    android:layout_width="16dp" android:layout_height="16dp"
                    android:layout_margin="8dp"
                    android:background="@drawable/pin_dot_empty"/>
                <View android:id="@+id/dot3"
                    android:layout_width="16dp" android:layout_height="16dp"
                    android:layout_margin="8dp"
                    android:background="@drawable/pin_dot_empty"/>
                <View android:id="@+id/dot4"
                    android:layout_width="16dp" android:layout_height="16dp"
                    android:layout_margin="8dp"
                    android:background="@drawable/pin_dot_empty"/>

            </LinearLayout>

            <!-- PIN pad -->
            <GridLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:columnCount="3"
                android:rowCount="4">

                <Button android:id="@+id/btn1" android:text="1" style="@style/PinButton"/>
                <Button android:id="@+id/btn2" android:text="2" style="@style/PinButton"/>
                <Button android:id="@+id/btn3" android:text="3" style="@style/PinButton"/>
                <Button android:id="@+id/btn4" android:text="4" style="@style/PinButton"/>
                <Button android:id="@+id/btn5" android:text="5" style="@style/PinButton"/>
                <Button android:id="@+id/btn6" android:text="6" style="@style/PinButton"/>
                <Button android:id="@+id/btn7" android:text="7" style="@style/PinButton"/>
                <Button android:id="@+id/btn8" android:text="8" style="@style/PinButton"/>
                <Button android:id="@+id/btn9" android:text="9" style="@style/PinButton"/>
                <Space android:layout_width="80dp" android:layout_height="80dp"/>
                <Button android:id="@+id/btn0" android:text="0" style="@style/PinButton"/>
                <Button android:id="@+id/btnBack2" android:text="⌫" style="@style/PinButton"/>

            </GridLayout>

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
