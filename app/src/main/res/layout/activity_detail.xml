<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/light_gray">

    <!-- Top Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="@color/primary"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="8dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:src="@drawable/ic_arrow_back"/>

        <!-- Type emoji -->
        <TextView
            android:id="@+id/tvTypeEmoji"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:gravity="center"
            android:textSize="20sp"/>

        <TextView
            android:id="@+id/tvScreenTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="Add Entry"
            android:textColor="@color/white"
            android:textSize="19sp"
            android:textStyle="bold"/>

        <!-- Edit button — visible in VIEW mode only -->
        <ImageButton
            android:id="@+id/btnEdit"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Edit"
            android:src="@drawable/ic_edit"
            android:visibility="gone"/>

        <ImageButton
            android:id="@+id/btnShare"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Share"
            android:src="@drawable/ic_share"
            android:visibility="gone"/>

        <!-- v19: Archive / Unarchive toggle button -->
        <ImageButton
            android:id="@+id/btnArchive"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Archive"
            android:src="@drawable/ic_archive"
            android:visibility="gone"/>

        <ImageButton
            android:id="@+id/btnDelete"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Delete"
            android:src="@drawable/ic_delete"
            android:visibility="gone"/>

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Dynamic fields added here by DetailActivity -->
            <LinearLayout
                android:id="@+id/fieldsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"/>

            <!-- v20: Checklist container — visible only for CHECKLIST type -->
            <LinearLayout
                android:id="@+id/checklistContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Progress label e.g. "3 of 5 done" -->
                <TextView
                    android:id="@+id/tvChecklistProgress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginBottom="8dp"/>

                <!-- Unchecked items injected here dynamically -->
                <LinearLayout
                    android:id="@+id/checklistUncheckedItems"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"/>

                <!-- Add item row — inactive: shows "+ Add item" label
                                  active:   shows ☐ [input] ✕ -->
                <LinearLayout
                    android:id="@+id/checklistAddRow"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp">

                    <!-- Inactive: "+" label. Hidden when active -->
                    <TextView
                        android:id="@+id/tvAddItemPlus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="+"
                        android:textSize="20sp"
                        android:textColor="@color/text_secondary"
                        android:layout_marginEnd="12dp"/>

                    <!-- Active: disabled checkbox (visual only). Hidden when inactive -->
                    <CheckBox
                        android:id="@+id/cbAddItemPreview"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:buttonTint="@color/text_primary"
                        android:enabled="false"
                        android:checked="false"
                        android:visibility="gone"/>

                    <EditText
                        android:id="@+id/etAddItem"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@null"
                        android:hint="Add item"
                        android:textColorHint="@color/hint_color"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:inputType="text"
                        android:imeOptions="actionUnspecified"
                        android:singleLine="true"/>

                    <!-- ✕ cancel — only visible when active -->
                    <ImageButton
                        android:id="@+id/btnCancelAddItem"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@drawable/ic_close"
                        android:tint="@color/text_secondary"
                        android:contentDescription="Cancel"
                        android:visibility="gone"/>

                </LinearLayout>

                <!-- Secondary "+ Add item" row — shown below active input row when focused -->
                <LinearLayout
                    android:id="@+id/checklistAddRowSecondary"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="+"
                        android:textSize="20sp"
                        android:textColor="@color/text_secondary"
                        android:layout_marginEnd="12dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Add item"
                        android:textSize="15sp"
                        android:textColor="@color/text_secondary"/>

                </LinearLayout>

                <!-- Divider row — only shown when there are checked items -->
                <LinearLayout
                    android:id="@+id/checklistDividerRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="4dp"
                    android:visibility="gone">

                    <View
                        android:id="@+id/checklistDivider"
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"
                        android:background="@color/divider"/>

                    <TextView
                        android:id="@+id/btnClearCompleted"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Clear completed"
                        android:textSize="12sp"
                        android:textColor="@color/text_secondary"
                        android:paddingStart="10dp"
                        android:paddingEnd="4dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:background="?attr/selectableItemBackgroundBorderless"/>

                </LinearLayout>

                <!-- Checked items injected here dynamically -->
                <LinearLayout
                    android:id="@+id/checklistCheckedItems"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"/>

                <!-- Empty state -->
                <TextView
                    android:id="@+id/tvChecklistEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="No items yet"
                    android:textColor="@color/hint_color"
                    android:textSize="14sp"
                    android:gravity="center"
                    android:paddingTop="16dp"
                    android:paddingBottom="16dp"
                    android:visibility="gone"/>

            </LinearLayout>

            <!-- v9: Attachment row — same style as a field row -->
            <LinearLayout
                android:id="@+id/attachmentRow"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="4dp">

                <!-- Label -->
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/attachment_label"
                    android:drawableStart="@drawable/ic_attachment"
                    android:drawablePadding="6dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"/>

                <!-- Filename + size (tappable in VIEW mode to open) -->
                <TextView
                    android:id="@+id/tvAttachmentName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="2"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:singleLine="true"
                    android:ellipsize="end"/>

                <!-- Open / Attach button -->
                <ImageButton
                    android:id="@+id/btnAttachOpen"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_attachment"
                    android:contentDescription="Attach or Open"
                    app:tint="@color/accent"/>

                <!-- Remove button -->
                <ImageButton
                    android:id="@+id/btnAttachRemove"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_close"
                    android:contentDescription="Remove attachment"
                    android:visibility="gone"
                    app:tint="@color/text_primary"/>

            </LinearLayout>

            <!-- v9: Size warning — shown only for 3–5MB files -->
            <TextView
                android:id="@+id/tvAttachmentWarning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/attachment_size_warning"
                android:textColor="@color/hint_color"
                android:textSize="11sp"
                android:layout_marginBottom="4dp"
                android:visibility="gone"/>

        </LinearLayout>
    </ScrollView>

    <!-- v9: Unsaved-changes action bar — slides up when Back pressed in EDIT mode with changes -->
    <LinearLayout
        android:id="@+id/saveActionBar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:background="@color/card_bg"
        android:elevation="8dp"
        android:visibility="gone">

        <!-- Save -->
        <LinearLayout
            android:id="@+id/btnBarSave"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="?attr/selectableItemBackground">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/ic_save"
                android:contentDescription="Save"
                app:tint="@color/text_primary"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Save"
                android:textSize="10sp"
                android:textColor="@color/text_primary"
                android:layout_marginTop="3dp"/>

        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/divider"/>

        <!-- Keep Editing -->
        <LinearLayout
            android:id="@+id/btnBarEdit"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="?attr/selectableItemBackground">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/ic_edit"
                android:contentDescription="Keep Editing"
                app:tint="@color/text_primary"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Keep Editing"
                android:textSize="10sp"
                android:textColor="@color/text_primary"
                android:layout_marginTop="3dp"/>

        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/divider"/>

        <!-- Discard -->
        <LinearLayout
            android:id="@+id/btnBarDiscard"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="?attr/selectableItemBackground">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/ic_close"
                android:contentDescription="Discard"
                app:tint="@color/text_primary"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Discard"
                android:textSize="10sp"
                android:textColor="@color/text_primary"
                android:layout_marginTop="3dp"/>

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
