<?xml version="1.0" encoding="utf-8"?>
<!-- Single attachment row used in DetailActivity. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:layout_marginBottom="6dp">

    <!-- Card body — full tap target to open -->
    <LinearLayout
        android:id="@+id/attachRowCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/tile_bg"
        android:padding="10dp"
        android:clickable="true"
        android:focusable="true">

        <!-- File icon — always grey -->
        <ImageView
            android:id="@+id/ivAttachIcon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_attachment"
            android:contentDescription="File"
            app:tint="@color/text_secondary"/>

        <!-- Filename  ·  size -->
        <TextView
            android:id="@+id/tvAttachLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:singleLine="true"
            android:ellipsize="middle"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="4dp"/>

        <!-- Remove button — visible in EDIT mode only -->
        <ImageButton
            android:id="@+id/btnAttachRowRemove"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_delete"
            android:contentDescription="Remove attachment"
            android:visibility="gone"
            app:tint="@color/text_secondary"/>

    </LinearLayout>

</LinearLayout>
