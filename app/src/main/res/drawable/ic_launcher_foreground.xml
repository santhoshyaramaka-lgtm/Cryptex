<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="1024"
    android:viewportHeight="1024">

    <!--
        Vault Door icon — Option 4
        ─────────────────────────────────────────────────────
        Elements:
          1. Outer vault ring    — dark steel blue with teal stroke
          2. Vault door face     — steel blue radial gradient
          3. Inner ring          — teal accent ring
          4. Centre lock wheel   — dark circle with teal highlight
          5. Bolt circles x8    — teal dots around the ring
          6. Handle bar          — white horizontal bar
    -->

    <!-- ── 1. OUTER VAULT RING ── -->
    <path
        android:fillColor="#37474F"
        android:pathData="M512,80 m-432,0 a432,432 0 1,0 864,0 a432,432 0 1,0 -864,0"/>
    <!-- Outer teal stroke ring -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#00BCD4"
        android:strokeWidth="28"
        android:pathData="M512,80 m-432,0 a432,432 0 1,0 864,0 a432,432 0 1,0 -864,0"/>

    <!-- ── 2. VAULT DOOR FACE — radial gradient steel blue ── -->
    <path
        android:pathData="M512,130 m-382,0 a382,382 0 1,0 764,0 a382,382 0 1,0 -764,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="512"
                android:centerY="512"
                android:gradientRadius="382">
                <item android:offset="0"   android:color="#546E7A"/>
                <item android:offset="0.6" android:color="#37474F"/>
                <item android:offset="1"   android:color="#263238"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- ── 3. INNER ACCENT RING ── -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#00ACC1"
        android:strokeWidth="20"
        android:pathData="M512,200 m-312,0 a312,312 0 1,0 624,0 a312,312 0 1,0 -624,0"/>

