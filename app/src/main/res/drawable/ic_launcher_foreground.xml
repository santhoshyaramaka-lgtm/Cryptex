    <!-- Top -->
    <path android:fillColor="#00BCD4"
        android:pathData="M512,210 m-22,0 a22,22 0 1,0 44,0 a22,22 0 1,0 -44,0"/>
    <!-- Bottom -->
    <path android:fillColor="#00BCD4"
        android:pathData="M512,790 m-22,0 a22,22 0 1,0 44,0 a22,22 0 1,0 -44,0"/>
    <!-- Left -->
    <path android:fillColor="#00BCD4"
        android:pathData="M200,500 m-22,0 a22,22 0 1,0 44,0 a22,22 0 1,0 -44,0"/>
    <!-- Right -->
