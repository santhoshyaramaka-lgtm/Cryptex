<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="1024"
    android:viewportHeight="1024">

    <!--
        Vault Door icon — V18.1 Safe Zone Fix
        ─────────────────────────────────────────────────────
        Android adaptive icon safe zone = 66.7% of 108dp canvas.
        In 1024 viewport: max safe radius from centre (512,512) = 341 units.
        All elements kept within r=230 outer ring → edge at 282, well inside 341.

        Radii used:
          Outer vault ring    r=230  (edge=282 — inside safe zone ✅)
          Vault door face     r=198
          Inner accent ring   r=155
          Centre lock wheel   r=85
          Bolts on ring       r=155 (cardinal) / 45° offset=110 (diagonal)
    -->

    <!-- ── 1. OUTER VAULT RING ── -->
    <path
        android:fillColor="#37474F"
        android:pathData="M512,512 m-230,0 a230,230 0 1,0 460,0 a230,230 0 1,0 -460,0"/>

    <!-- Outer glow ring (wide transparent — neon glow effect) -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#00BCD4"
        android:strokeWidth="32"
        android:strokeAlpha="0.20"
        android:pathData="M512,512 m-230,0 a230,230 0 1,0 460,0 a230,230 0 1,0 -460,0"/>

    <!-- Outer teal stroke ring — main -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#00BCD4"
        android:strokeWidth="18"
        android:pathData="M512,512 m-230,0 a230,230 0 1,0 460,0 a230,230 0 1,0 -460,0"/>

    <!-- ── 2. VAULT DOOR FACE — radial gradient steel blue ── -->
    <path
        android:pathData="M512,512 m-198,0 a198,198 0 1,0 396,0 a198,198 0 1,0 -396,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="512"
                android:centerY="512"
                android:gradientRadius="198">
                <item android:offset="0"   android:color="#546E7A"/>
                <item android:offset="0.6" android:color="#37474F"/>
                <item android:offset="1"   android:color="#263238"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- ── 3. INNER ACCENT RING — double ring with glow ── -->
    <!-- Glow layer -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#00E5FF"
        android:strokeWidth="22"
        android:strokeAlpha="0.15"
        android:pathData="M512,512 m-155,0 a155,155 0 1,0 310,0 a155,155 0 1,0 -310,0"/>
    <!-- Main ring -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#00ACC1"
        android:strokeWidth="13"
        android:pathData="M512,512 m-155,0 a155,155 0 1,0 310,0 a155,155 0 1,0 -310,0"/>

    <!-- ── 4. CENTRE LOCK WHEEL ── -->
    <path
        android:fillColor="#263238"
        android:pathData="M512,512 m-85,0 a85,85 0 1,0 170,0 a85,85 0 1,0 -170,0"/>
    <path
        android:fillColor="#00000000"
        android:strokeColor="#00E5FF"
        android:strokeWidth="11"
        android:pathData="M512,512 m-85,0 a85,85 0 1,0 170,0 a85,85 0 1,0 -170,0"/>

    <!-- ── 5. KEYHOLE — white with teal glow stroke ── -->
    <!-- Keyhole circle -->
    <path
        android:fillColor="#FFFFFF"
        android:strokeColor="#00E5FF"
        android:strokeWidth="4"
        android:pathData="M512,484 m-19,0 a19,19 0 1,0 38,0 a19,19 0 1,0 -38,0"/>
    <!-- Keyhole slot -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M502,484 L522,484 L518,526 L506,526 Z"/>

    <!-- ── 6. BOLT CIRCLES — cardinal: teal | diagonal: gold ── -->
    <!-- Cardinal bolts (top/bottom/left/right) on r=155 -->
    <path android:fillColor="#00BCD4"
        android:pathData="M512,357 m-15,0 a15,15 0 1,0 30,0 a15,15 0 1,0 -30,0"/>
    <path android:fillColor="#00BCD4"
        android:pathData="M512,667 m-15,0 a15,15 0 1,0 30,0 a15,15 0 1,0 -30,0"/>
    <path android:fillColor="#00BCD4"
        android:pathData="M357,512 m-15,0 a15,15 0 1,0 30,0 a15,15 0 1,0 -30,0"/>
    <path android:fillColor="#00BCD4"
        android:pathData="M667,512 m-15,0 a15,15 0 1,0 30,0 a15,15 0 1,0 -30,0"/>

    <!-- Diagonal bolts at 45° on r=155 → offset ≈110 → positions 402,402 / 622,402 / 402,622 / 622,622 -->
    <path android:fillColor="#FFD700"
        android:strokeColor="#FFA000"
        android:strokeWidth="4"
        android:pathData="M402,402 m-15,0 a15,15 0 1,0 30,0 a15,15 0 1,0 -30,0"/>
    <path android:fillColor="#FFD700"
        android:strokeColor="#FFA000"
        android:strokeWidth="4"
        android:pathData="M622,402 m-15,0 a15,15 0 1,0 30,0 a15,15 0 1,0 -30,0"/>
    <path android:fillColor="#FFD700"
        android:strokeColor="#FFA000"
        android:strokeWidth="4"
        android:pathData="M402,622 m-15,0 a15,15 0 1,0 30,0 a15,15 0 1,0 -30,0"/>
    <path android:fillColor="#FFD700"
        android:strokeColor="#FFA000"
        android:strokeWidth="4"
        android:pathData="M622,622 m-15,0 a15,15 0 1,0 30,0 a15,15 0 1,0 -30,0"/>

    <!-- ── 7. HANDLE BAR ── -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#ECEFF1"
        android:strokeWidth="18"
        android:strokeLineCap="round"
        android:pathData="M450,590 L574,590"/>

</vector>
