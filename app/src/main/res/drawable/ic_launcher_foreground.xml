    <path
        android:fillColor="#00000000"
        android:strokeColor="#00E5FF"
        android:strokeWidth="16"
        android:pathData="M512,370 m-142,0 a142,142 0 1,0 284,0 a142,142 0 1,0 -284,0"/>
