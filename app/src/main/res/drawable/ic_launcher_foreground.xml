    <path
        android:fillColor="#00BCD4"
        android:pathData="M512,430 m-30,0 a30,30 0 1,0 60,0 a30,30 0 1,0 -60,0"/>
    <!-- Lock keyhole — slot -->
    <path
        android:fillColor="#00BCD4"
        android:pathData="M496,460 L528,460 L522,530 L502,530 Z"/>

